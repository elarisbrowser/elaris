#!/bin/sh
cargo_home=${CARGO_HOME:-${HOME:+$HOME/.cargo}}
if [ -n "$cargo_home" ] && [ -d "$cargo_home/bin" ]; then
    case ":$PATH:" in
        *":$cargo_home/bin:"*) ;;
        *) export PATH="$cargo_home/bin:$PATH" ;;
    esac
fi

ELARIS_PYTHON=${ELARIS_PYTHON:-python3}
if ! command -v "$ELARIS_PYTHON" >/dev/null 2>&1; then
    printf '%s\n' "elaris: Python 3.9 or newer is required (set ELARIS_PYTHON to its path)." >&2
    exit 127
fi
if ! "$ELARIS_PYTHON" -c 'import sys; sys.exit(sys.version_info < (3, 9))'; then
    printf '%s\n' "elaris: Python 3.9 or newer is required; set ELARIS_PYTHON to a compatible interpreter." >&2
    exit 1
fi

exec "$ELARIS_PYTHON" "$(dirname "$0")/tools/cli.py" "$@"
