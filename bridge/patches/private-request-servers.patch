+void RequestServerManager::retire_private_session(BrowsingSession& session)
+{
+    VERIFY(session.is_private() == IsPrivate::Yes);
+    s_last_retired_private_session_id = max(s_last_retired_private_session_id, session.id());
+    for (auto& instance : Vector { m_instances }) {
+        if (&instance->session() != &session)
+            continue;
+
+        auto client_ids = move(instance->m_client_ids);
+        for (auto client_id : client_ids)
+            Application::the().did_disconnect_request_server_client(client_id);
+        Application::the().did_disconnect_request_server_client(instance->ui_client().request_server_client_id());
+        instance->m_idle_timer = nullptr;
+        retire(*instance);
+        instance->ui_client().shutdown();
+        instance->control_client().shutdown();
+    }
+}
